# Telegram
BOT_TOKEN=123456:your-bot-token-from-botfather
ALLOWED_USER_ID=123456789
WEBHOOK_SECRET=choose-a-random-secret-string

# Google Drive OAuth (личный аккаунт, не service account)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GDRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Заполняется автоматически на Render — для локального запуска через ngrok
# впишите сюда публичный https-адрес туннеля (без слэша на конце)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Локально можно не задавать — Render передаёт PORT сам
PORT=8080
